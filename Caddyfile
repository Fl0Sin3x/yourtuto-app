{
	frankenphp {
		worker {
			file /app/worker.php
			num 4
		}
	}
	auto_https off
}

:{$PORT:8080} {
	root * /app/public

	# SEO: sitemap/robots + public SPA pages served with server-rendered <head> (SSR-lite)
	@seo {
		path_regexp seo ^/(tutorials(/[0-9]+(/[a-z0-9-]+)?)?|paths(/[a-z0-9-]+)?|c/[a-z0-9-]+|stats|category/[a-z0-9-]+|sitemap\.xml|robots\.txt)?/?$
		not path /tutorials/*/edit
	}
	handle @seo {
		php_server
	}

	# Static assets with long cache (hashed filenames)
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# PWA: the service worker must always be revalidated; manifest needs its MIME type
	@sw path /sw.js
	handle @sw {
		header Cache-Control "no-cache"
		file_server
	}
	@manifest path /manifest.webmanifest
	handle @manifest {
		header Content-Type "application/manifest+json"
		file_server
	}

	# Other static files
	@static file
	handle @static {
		file_server
	}

	# Symfony routes
	@symfony path_regexp ^/(api|auth|admin|_profiler|_wdt)(/|$)
	handle @symfony {
		php_server
	}

	# React SPA fallback
	handle {
		try_files {path} /index.html
		file_server
	}
}
