# Copy to .env.local (or .env) and fill in real values. Never commit real secrets.
# Real environment variables always take precedence over .env files.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change-me-generate-with-openssl-rand-hex-16
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8002
FRONTEND_URL=http://localhost:3000
# Public base URL used for canonical URLs, Open Graph, sitemap.xml and robots.txt
SITE_URL=http://localhost:3000
###< symfony/routing ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=change-me
###< lexik/jwt-authentication-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> redis ###
REDIS_URL=redis://127.0.0.1:6379
###< redis ###

###> symfony/mailer ###
# Local: Mailpit from compose.override.yaml
MAILER_DSN=smtp://127.0.0.1:1025
###< symfony/mailer ###

###> oauth ###
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
###< oauth ###

###> external apis (all optional) ###
YOUTUBE_API_KEY=
DEVTO_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SPOONACULAR_API_KEY=
ANTHROPIC_API_KEY=
# Opt-in: AI TL;DR summaries call the Anthropic API (paid). Off by default -> free extractive fallback.
SUMMARY_AI_ENABLED=0
###< external apis ###
